{...}: {
  flake.modules.homeManager.hyprland = {...}: {
    # Keep the wallpaper available to Dux's wallpaper picker. Dux owns the
    # selected wallpaper and applies its generated colors to the desktop.
    home.file."Pictures/wallpapers/background.jpg".source = ../../rsc/background.jpg;

    # Hyprland 0.57 only reads Lua. Keep a small declarative entry point that
    # loads Dux's generated fragments, with a Hyprland 0.57-compatible shadow.
    xdg.configFile."hypr/hyprland.lua".text = ''
      hl.config({ autogenerated = false })

      hl.on("hyprland.start", function()
        hl.exec_cmd("dbus-update-activation-environment --systemd --all")
        hl.exec_cmd("systemctl --user start hyprland-session.target")
      end)

      hl.config({
        input = {
          kb_layout = "",
          numlock_by_default = true,
          follow_mouse = 0,
          touchpad = {
            tap_to_click = true,
            natural_scroll = true,
          },
        },
        decoration = {
          shadow = {
            enabled = true,
            range = 30,
            render_power = 4,
            offset = "0 5",
            color = "rgba(00000070)",
          },
        },
        misc = {
          disable_hyprland_logo = true,
          disable_splash_rendering = true,
        },
        dwindle = { preserve_split = true },
        master = { mfact = 0.5 },
      })

      hl.animation({ leaf = "windowsIn", enabled = true, speed = 3, bezier = "default" })
      hl.animation({ leaf = "windowsOut", enabled = true, speed = 3, bezier = "default" })
      hl.animation({ leaf = "workspaces", enabled = true, speed = 5, bezier = "default" })
      hl.animation({ leaf = "windowsMove", enabled = true, speed = 4, bezier = "default" })
      hl.animation({ leaf = "fade", enabled = true, speed = 3, bezier = "default" })
      hl.animation({ leaf = "border", enabled = true, speed = 3, bezier = "default" })

      -- Dux-managed compositor settings and user bindings.
      require("dms.colors")
      require("dms.outputs")
      require("dms.layout")
      require("dms.cursor")
      require("dms.binds")
      require("dms.binds-user")
      require("dms.windowrules")
    '';

    xdg.configFile."hypr/dms/binds-user.lua".text = ''
      -- Make Super+Space toggle floating instead of opening Spotlight.
      hl.unbind("SUPER + space")
      hl.bind("SUPER + space", hl.dsp.window.float({ action = "toggle" }))

      -- Pin a floating window across workspaces, like a picture-in-picture window.
      hl.unbind("SUPER + SHIFT + space")
      hl.bind("SUPER + SHIFT + space", hl.dsp.window.pin({ action = "toggle" }))and

      hl.bind("SUPER + Return", hl.dsp.exec_cmd("foot"))
      hl.bind("SUPER + D", hl.dsp.exec_cmd("dms ipc call spotlight toggle"))
      hl.unbind("SUPER + Escape")
      hl.bind("SUPER + Escape", hl.dsp.exec_cmd("dms ipc call powermenu toggle"))

      hl.unbind("SUPER + S")
      hl.bind("SUPER + S", hl.dsp.exec_cmd("dms ipc call quickCapture screenshot region edit"))
      hl.unbind("SUPER + SHIFT + S")
      hl.bind("SUPER + SHIFT + S", hl.dsp.exec_cmd("dms ipc call quickCapture screenshot full edit"))

      -- Select workspaces by their position on the focused monitor.
      for i = 1, 10 do
        local key = tostring(i % 10)
        local workspace = "r~" .. tostring(i)

        hl.unbind("SUPER + " .. key)
        hl.bind("SUPER + " .. key, hl.dsp.focus({ workspace = workspace }))

        hl.unbind("SUPER + SHIFT + " .. key)
        hl.bind("SUPER + SHIFT + " .. key, hl.dsp.window.move({
          workspace = workspace,
          follow = false,
        }))
      end
    '';

    # NixOS installs the plugin source; Dux keeps its enabled state separately.
    xdg.configFile."dms/plugin_settings.json" = {
      force = true;
      text = builtins.toJSON {
        quickCapture.enabled = true;
      };
    };
  };
}
